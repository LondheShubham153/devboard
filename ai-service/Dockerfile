FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# pipefail: a failing command on the left of a pipe must fail the build.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY requirements.txt requirements.lock ./
# Install only from the hashed lock: reproducible, wheels only, and a tampered or
# swapped package fails the hash check. The lock is generated by ./lock.sh, which
# runs `opentelemetry-bootstrap` to pick the instrumentation packages.
RUN pip install --no-cache-dir --require-hashes --only-binary :all: -r requirements.lock \
    # Drift guard: fail the build if bootstrap would instrument something the lock lacks.
    && opentelemetry-bootstrap -a requirements | cut -d= -f1 | xargs pip show > /dev/null

COPY app ./app

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER 10001

EXPOSE 3005

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
    CMD ["sh", "-c", "curl -fsS http://localhost:3005/health || exit 1"]

# --threads 32: gthread holds a thread for a whole SSE stream, and a full pool stops /health.
CMD ["opentelemetry-instrument", \
     "gunicorn", "--bind", "0.0.0.0:3005", "--workers", "1", "--threads", "32", \
     "--timeout", "600", "--access-logfile", "-", "--error-logfile", "-", "app.main:app"]
