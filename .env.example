# Copy to .env (or run `make setup`). Compose substitutes these into docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard

# --- Backend (Go API) ---
# Must match the vite proxy target in frontend/vite.config.js.
BACKEND_PORT=8080

# --- Host port mappings (host side of host:container) ---
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8080
