# Copy to .env (or run `make setup`). Compose substitutes these into docker-compose.yml.

# --- Postgres ---
POSTGRES_USER=devboard
POSTGRES_PASSWORD=devboard
POSTGRES_DB=devboard

# --- Backend (Go API) ---
# Must match the vite proxy target in frontend/vite.config.js.
BACKEND_PORT=8080

# --- Host port mappings (host side of host:container) ---
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8080

# --- AI assistant (only used with: docker compose --profile ai up) ---
MODEL_NAME=llama3.2:1b

# --- Base images for local builds ---
# The Dockerfiles default to Docker Hardened Images (dhi.io), which need
# `docker login dhi.io`. These public images work with no login. To use DHI
# locally instead, delete these three lines after logging in.
GO_IMAGE=golang:1.26-alpine
NODE_BUILD_IMAGE=node:26-alpine
NODE_RUNTIME_IMAGE=node:26-alpine
